    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.6.2",
    "d3-geo": "3.1.1",
    "exceljs": "^4.4.0",
    "jsdom": "^30.1.3",
    "postcss": "^8.5.32",
